# Secret used to sign the GitHub login session cookie.
# Optional in development (a default is used). Set it in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Server-only Miku "Explain this error" assistant (optional).
# The browser never sees these — the route /api/explain-error reads them server-side.
# If unset, the button in lesson playgrounds shows an Arabic "not enabled yet" note.
# Use any OpenAI-compatible chat completions provider you control.
MIKU_AI_API_KEY=
MIKU_AI_MODEL=
# Defaults to OpenAI's chat completions endpoint; any compatible URL works.
# MIKU_AI_BASE_URL=https://api.openai.com/v1/chat/completions
# MIKU_AI_MAX_TOKENS=220
