{
  "name": "etm-learning",
  "version": "1.0.0",
  "private": true,
  "description": "ETM - منصة تعليم البرمجة من الصفر إلى الاحتراف بلغة C++",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:content": "node --experimental-strip-types scripts/validate-content.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "lucide-react": "0.454.0",
    "next": "^14.2.35",
    "prismjs": "1.29.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-simple-code-editor": "0.14.1",
    "react-syntax-highlighter": "15.5.0",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "22.9.0",
    "@types/prismjs": "1.26.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-syntax-highlighter": "15.5.13",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
